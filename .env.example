# ============================================================================
#  KONFIGURACJA REKLAMA GATEWAY
#  Skopiuj ten plik jako ".env" i uzupelnij. Plik .env jest prywatny
#  (nie trafia do gita) i nigdy nie opuszcza Twojego komputera.
#  Skrypt setup.ps1 uzupelni puste wartosci automatycznie.
# ============================================================================

# --- Brama (lokalnie) -------------------------------------------------------
# Na jakim porcie i adresie nasluchuje brama. 127.0.0.1 = tylko lokalnie,
# bo na swiat wystawia ja tunel Cloudflare (a nie router).
PORT=8080
HOST=127.0.0.1

# --- Twoje narzedzie webowe -------------------------------------------------
# Adres Twojej aplikacji webowej dzialajacej lokalnie. Brama bedzie do niej
# przekierowywac ruch po zalogowaniu. Przyklad: http://127.0.0.1:3000
# Zostaw puste, jesli na razie chcesz tylko zobaczyc strone powitalna.
UPSTREAM_URL=

# Alternatywnie: zamiast przekierowywac do aplikacji, mozesz serwowac
# pliki statyczne z folderu (np. zbudowany frontend). Podaj sciezke.
STATIC_DIR=

# --- Dostep (anonimowy, wspolne haslo) --------------------------------------
# Jedno wspolne haslo dla wszystkich pracownikow. Bez kont, bez danych osobowych.
# Jesli zostawisz puste, setup.ps1 wygeneruje mocne haslo automatycznie.
ACCESS_PASSWORD=

# Sekret do podpisywania ciasteczek sesji. setup.ps1 wygeneruje losowy.
SESSION_SECRET=

# Jak dlugo wazna jest sesja po zalogowaniu (w godzinach).
SESSION_TTL_HOURS=12

# --- Tunel Cloudflare -------------------------------------------------------
# DOMYSLNIE: tryb szybki - losowy adres *.trycloudflare.com, bez konta Cloudflare.
# Wystarcza w 100% i jest w pelni autonomiczny. Adres moze zmienic sie po restarcie.
#
# OPCJONALNIE (staly adres na Twojej domenie): zaloz darmowe konto Cloudflare,
# utworz tunel nazwany i wklej tutaj jego token. Wtedy adres bedzie staly.
# Instrukcja w README, sekcja "Staly adres".
CLOUDFLARE_TUNNEL_TOKEN=

# --- Wyglad -----------------------------------------------------------------
BRAND_NAME=Reklama

# Brama dziala za tunelem (proxy), wiec ufamy naglowkom X-Forwarded-*.
TRUST_PROXY=true

# --- Udostepnianie URZADZENIA w terenie (np. interfejs OBD2) -----------------
# Dotyczy pliku "7 - Udostepnij urzadzenie w terenie.bat".
# Pozwala polaczyc sie zdalnie z urzadzeniem sieciowym (np. adapterem OBD2)
# przez prywatna siec Tailscale - tak, jakby stalo sie obok niego.
#
# DEVICE_HOST - adres urzadzenia w Twojej domowej sieci.
#   * jesli urzadzenie ma wlasny adres WiFi w sieci domowej: wpisz ten adres,
#     np. 192.168.0.50
#   * jesli laczy sie przez program/serwer na tym komputerze: zostaw 127.0.0.1
DEVICE_HOST=127.0.0.1

# DEVICE_PORT - port urzadzenia. Dla adapterow WiFi OBD/ELM327 czesto 35000.
# Sprawdz w instrukcji swojego urzadzenia/programu.
DEVICE_PORT=

# DEVICE_LISTEN_PORT - port, pod ktorym laczysz sie w terenie.
# Zostaw puste = taki sam jak DEVICE_PORT.
DEVICE_LISTEN_PORT=
