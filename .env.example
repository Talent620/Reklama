# --- Database ---
# Postgres in production, SQLite fine for local dev.
DATABASE_URL="postgresql://reklama:reklama@localhost:5432/reklama?schema=public"

# --- AI provider (optional) ---
# When set, the engine uses the Claude API for strategy/copy/creative generation.
# When unset, the engine falls back to its deterministic rule-based provider,
# so the whole pipeline still runs offline (and tests stay reproducible).
ANTHROPIC_API_KEY=""
REKLAMA_AI_MODEL="claude-sonnet-4-6"

# --- Channel adapters (optional, official APIs only) ---
# Leave empty to run channels in DRY-RUN mode (no external calls, nothing published).
GOOGLE_ADS_DEVELOPER_TOKEN=""
LINKEDIN_ADS_ACCESS_TOKEN=""
TIKTOK_ADS_ACCESS_TOKEN=""

# Meta Ads (first channel with a real publish path). All three are required to
# create campaigns; even then objects are created PAUSED — activation is a
# separate, deliberate human action in Ads Manager. No spend happens here.
META_ADS_ACCESS_TOKEN=""        # System User token from Business Manager
META_ADS_AD_ACCOUNT_ID=""       # e.g. act_1234567890 (or just the digits)
META_ADS_PAGE_ID=""             # Facebook Page id used in ad creatives

# --- Safety rails ---
# Hard ceiling (in account currency) the autonomous loop may never exceed
# without explicit human approval.
REKLAMA_MAX_DAILY_BUDGET="50"
# Require human sign-off before any campaign goes from DRAFT to LIVE.
REKLAMA_REQUIRE_HUMAN_APPROVAL="true"
