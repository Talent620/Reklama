# === Reklama — konfiguracja ===
# Skopiuj ten plik do `.env` i uzupełnij wartości.

# Klucz API do modelu flagowego (Claude Opus 4.8).
# Pobierz z https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Model używany do analizy i generowania promptów.
# Domyślnie najmocniejszy model flagowy.
REKLAMA_MODEL=claude-opus-4-8

# Poziom "wysiłku" modelu: low | medium | high | xhigh | max
# Wyższy = lepsza jakość analizy, ale wolniej i drożej.
REKLAMA_EFFORT=high

# === Google Play (publikacja) ===
# Ścieżka do pliku JSON konta serwisowego z uprawnieniami w Google Play Console.
# Instrukcja w README.md sekcja "Konfiguracja Google Play".
GOOGLE_PLAY_CREDENTIALS=./play-credentials.json
